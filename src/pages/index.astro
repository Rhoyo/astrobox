---
import Layout from '~/layouts/PageLayout.astro';
import ParallaxPoems from '~/components/widgets/ParallaxPoems.astro';
import Content from '~/components/widgets/Content.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, I18N } from 'astrowind:config';
import type { Poem } from '~/types';

const metadata = {
  title: 'Four Poems',
  description: 'Four poems on change, aging, dissonance and death, tagged by theme.',
};

const poems: Array<Poem> = [
  {
    title: 'Calving',
    image: { src: '~/assets/images/glacier.svg', alt: '' },
    themes: ['aging', 'change'],
    stanzas: [
      'the dying crackle falling glaciers release; the same note your voice quivers over before icy tears escape.',
    ],
  },
  {
    title: 'Experiences',
    image: { src: '~/assets/images/marble-grooves.svg', alt: '' },
    themes: ['aging'],
    stanzas: [
      'The grooves that drape your face are etched by the hands of the clock, painted by the depth of your emotion.',
    ],
  },
  {
    title: 'Duality',
    image: { src: '~/assets/images/night-day.svg', alt: '' },
    themes: ['cognitive dissonance'],
    stanzas: [
      `He rested on the seventh day …
… and on the seventh night lay awake restless`,
    ],
  },
  {
    title: 'Artistry',
    image: { src: '~/assets/images/white-room.svg', alt: '' },
    themes: ['death'],
    stanzas: [
      'These four walls are an empty canvas. Someday I’ll aim my brush under my jaw and paint the walls with the beauty of my mind.',
    ],
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: metadata.title,
  url: SITE?.site,
  inLanguage: I18N?.language,
  hasPart: poems.map((poem) => ({
    '@type': 'CreativeWork',
    name: poem.title,
    keywords: poem.themes?.join(', '),
  })),
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <ParallaxPoems
    id="poems"
    title="ρ"
    subtitle="Four poems on change, aging, dissonance and death, each tagged with the themes it turns on."
    image={{ src: '~/assets/images/snowy-woods.svg', alt: '' }}
    poems={poems}
  />

  <Content
    id="density"
    isCentered
    isDark
    classes={{ headline: { title: 'text-4xl md:text-5xl font-bold tracking-tighter mb-4 font-heading text-white' } }}
    tagline="The symbol"
    title="ρ — density"
    content="ρ (rho, the Greek letter r) is the symbol physics uses for <strong>density</strong>: how much mass is packed into a given volume. It is defined as <strong>ρ = m / V</strong>, mass divided by volume, and measured in kilograms per cubic metre (kg/m³)."
    columns={3}
    items={[
      {
        title: 'Liquid water ≈ 1000 kg/m³',
        description: 'One litre of water has a mass of about one kilogram. Water is densest at about 4 °C.',
        icon: 'tabler:droplet',
      },
      {
        title: 'Ice ≈ 917 kg/m³',
        description:
          'Ice is less dense than the water it freezes from, which is why it floats and lakes freeze from the top down.',
        icon: 'tabler:snowflake',
      },
      {
        title: 'Air ≈ 1.2 kg/m³',
        description: 'At sea level, air is roughly 800 times less dense than water.',
        icon: 'tabler:wind',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gradient-to-b from-black to-zinc-800"></div>
    </Fragment>
  </Content>
</Layout>
